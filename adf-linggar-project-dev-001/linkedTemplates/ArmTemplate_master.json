{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-linggar-project-dev-001"
		},
		"ls_adls_linggar_project_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_linggar_project'"
		},
		"ls_adls_linggar_project_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stlinggarprojectdev001.dfs.core.windows.net/"
		},
		"ls_rest_ridehailing_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://data.cityofnewyork.us/resource/4p5c-cbgn.json?$limit=5000"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-linggar-project-dev-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_linggar_project_accountKey": {
						"value": "[parameters('ls_adls_linggar_project_accountKey')]"
					},
					"ls_adls_linggar_project_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_linggar_project_properties_typeProperties_url')]"
					},
					"ls_rest_ridehailing_api_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_ridehailing_api_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}