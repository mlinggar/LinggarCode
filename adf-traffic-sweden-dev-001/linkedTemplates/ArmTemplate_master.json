{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-traffic-sweden-dev-001"
		},
		"ls_azure_function_ingestor_functionKey": {
			"type": "secureString",
			"metadata": "Secure string for 'functionKey' of 'ls_azure_function_ingestor'"
		},
		"ls_azure_function_ingestor_properties_typeProperties_functionAppUrl": {
			"type": "string",
			"defaultValue": "https://func-traffic-sweden-dev-001.azurewebsites.net"
		},
		"trg_hourly_trafikverket_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type": {
			"type": "string",
			"defaultValue": "trafikverket"
		},
		"trg_hourly_weather_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type": {
			"type": "string",
			"defaultValue": "openweathermap"
		},
		"trg_weekly_openstreetmap_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type": {
			"type": "string",
			"defaultValue": "openstreetmap"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-traffic-sweden-dev-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azure_function_ingestor_functionKey": {
						"value": "[parameters('ls_azure_function_ingestor_functionKey')]"
					},
					"ls_azure_function_ingestor_properties_typeProperties_functionAppUrl": {
						"value": "[parameters('ls_azure_function_ingestor_properties_typeProperties_functionAppUrl')]"
					},
					"trg_hourly_trafikverket_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type": {
						"value": "[parameters('trg_hourly_trafikverket_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type')]"
					},
					"trg_hourly_weather_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type": {
						"value": "[parameters('trg_hourly_weather_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type')]"
					},
					"trg_weekly_openstreetmap_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type": {
						"value": "[parameters('trg_weekly_openstreetmap_properties_pl_ingest_nordic_traffic_data_parameters_ingestor_type')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}